{
  "name": "@vehicore/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript & JavaScript SDK for Vehicore vehicle image processing and automotive data APIs (OCR, damage recognition, GDPR anonymization, car position, classification, normalization, valuation, renders, and claims).",
  "license": "MIT",
  "homepage": "https://vehicore.pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/araratmartirossyan/vehicore-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/araratmartirossyan/vehicore-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "vehicore",
    "automotive",
    "vehicle",
    "alpr",
    "license-plate-ocr",
    "vin-ocr",
    "damage-detection",
    "anonymization",
    "gdpr",
    "car-valuation",
    "sdk",
    "typescript"
  ],
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
